{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchdiff.example/schema/launchdiff.config.schema.json",
  "title": "LaunchDiff Site Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sites"],
  "properties": {
    "version": {
      "const": 1
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/site"
      }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environments"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "environments": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/environment"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    }
  }
}
